// schema.prisma — Descargo & Cargo API
//
// Subconjunto acotado (MVP) del esquema completo definido en
// ../../PLAN_INTEGRAL_V3.md §5. Cubre lo que el frontend actual
// necesita: auth, cargas, desbloqueo de contacto (monetización core)
// y membresías. Deliberadamente NO incluye todavía: PostGIS/geo,
// Oferta/Viaje (negociación y ejecución del viaje), Vehiculo, AuditLog,
// rotación de refresh tokens, ni la pasarela Wompi real — eso llega
// cuando se migre de SQLite a PostgreSQL siguiendo docs/GUIA_SERVIDOR_BAJO_COSTO.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  PUBLICADOR
  TRANSPORTADOR
}

enum TipoPublicacion {
  NACIONAL
  URBANA
  BARBACHA
}

enum EstadoCarga {
  DISPONIBLE
  ASIGNADA
  CANCELADA
}

enum EstadoPago {
  PENDIENTE
  VERIFICADO
  RECHAZADO
}

enum TipoMembresia {
  GRATIS
  BASICA
  GOLD
  ILIMITADA
}

model Usuario {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  // Celular normalizado (10 dígitos, sin +57) para iniciar sesión con él en
  // vez del correo. Único; null en cuentas eliminadas o sin número válido.
  celular      String?     @unique
  passwordHash String
  tipo         TipoUsuario
  createdAt    DateTime    @default(now())

  // Ley 1581 de 2012: registro versionado de aceptación de Términos y
  // Política de datos (Habeas Data), y marca de baja para el derecho de
  // supresión (se anonimiza, no se borra la fila — hay pagos/cargas
  // ligados que deben conservarse por obligación contable/fiscal).
  terminosVersion     String    @default("1.0")
  terminosAceptadosEn DateTime  @default(now())
  terminosIp          String?
  eliminadoEn         DateTime?
  // Versión de sesión: va dentro del JWT; subirla (al restablecer la
  // contraseña) invalida todas las sesiones abiertas de la cuenta.
  sesionVersion       Int       @default(0)
  // Acceso al panel /admin. Solo se activa a mano en el servidor (no hay
  // ninguna ruta que lo cambie) y se consulta en BD en cada petición.
  esAdmin             Boolean   @default(false)

  // Última ubicación reportada por el navegador (con permiso del usuario),
  // para las alertas de vía geolocalizadas. Nula hasta que active la opción.
  ultimaLat         Float?
  ultimaLon         Float?
  ultimaUbicacionEn DateTime?

  // Recuperar contraseña: token de un solo uso con vencimiento corto.
  resetToken       String?   @unique
  resetTokenExpira DateTime?

  publicador    Publicador?
  transportador Transportador?
  suscripciones SuscripcionPush[]
}

// Una fila por navegador/dispositivo donde el usuario activó las
// notificaciones (Web Push estándar -- gratis, la entrega la hace el
// navegador/SO, no un servicio de terceros pago).
model SuscripcionPush {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Publicador {
  id        Int    @id @default(autoincrement())
  usuarioId Int    @unique
  nombre    String
  ciudad    String
  telefono  String
  documento String @unique // KYC nivel 1: cédula autodeclarada. Nivel 2 (RNEC/RUNT) pendiente de integración externa.

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cargas  Carga[]
}

model Transportador {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @unique
  nombre    String
  ciudad    String
  telefono  String
  documento String  @unique // KYC nivel 1: cédula autodeclarada. Nivel 2 (RNEC/RUNT) pendiente de integración externa.
  // Placa autodeclarada del vehículo; se le envía al publicador al desbloquear.
  // Opcional en BD solo por las cuentas anteriores: se pide antes del primer desbloqueo.
  placa     String?

  usuario         Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  membresia       Membresia?
  pagosDesbloqueo PagoDesbloqueo[]
  viajes          Viaje[]
}

model Membresia {
  id              Int           @id @default(autoincrement())
  transportadorId Int           @unique
  tipo            TipoMembresia @default(GRATIS)
  createdAt       DateTime      @default(now())

  transportador Transportador @relation(fields: [transportadorId], references: [id], onDelete: Cascade)
}

model Carga {
  id                Int             @id @default(autoincrement())
  publicadorId      Int
  titulo            String
  tipoCarga         String
  origen            String
  destino           String
  toneladas         Float
  precio            Int
  pisoSiceTac       Int
  fechaCarga        DateTime
  tipoPublicacion   TipoPublicacion
  vehiculoRequerido String
  verificado        Boolean         @default(false)
  destacada         Boolean         @default(false)
  // Carga de demostración (lanzamiento): se muestra marcada como Ejemplo y
  // no se puede desbloquear -- nadie debe pagar por un contacto que no existe.
  ejemplo           Boolean         @default(false)
  estado            EstadoCarga     @default(DISPONIBLE)
  createdAt         DateTime        @default(now())

  publicador      Publicador       @relation(fields: [publicadorId], references: [id], onDelete: Cascade)
  pagosDesbloqueo PagoDesbloqueo[]

  viajes Viaje[]

  @@index([estado, tipoPublicacion])
}

// Monetización core: 6% del flete (mínimo $15.000, máximo $100.000 COP) por desbloquear
// el contacto de una carga, o gratis si la membresía del transportador
// todavía tiene cupos. Ver PLAN_INTEGRAL_V3.md §5 (PagoDesbloqueo).
model PagoDesbloqueo {
  id              Int        @id @default(autoincrement())
  cargaId         Int
  transportadorId Int
  monto           Int
  referencia      String?    @unique // referencia única de Wompi; se regenera en cada reintento
  estado          EstadoPago @default(PENDIENTE)
  createdAt       DateTime   @default(now())

  carga         Carga         @relation(fields: [cargaId], references: [id], onDelete: Cascade)
  transportador Transportador @relation(fields: [transportadorId], references: [id], onDelete: Cascade)

  @@unique([cargaId, transportadorId])
}

enum TipoInteresProspecto {
  TRANSPORTADOR
  PUBLICADOR
}

// Leads de la prospección 2023 (registro MinTransporte, Facebook, sectorial)
// -- NO son cuentas de Usuario: nunca aceptaron los Términos/Política
// actuales ni tienen contraseña. Se usan solo para campañas de invitación
// (correo/WhatsApp) a registrarse de verdad en la plataforma ya en vivo.
// Importado una vez con server/scripts/importar-prospectos.js — ver
// server/scripts/normalizar_prospectos.py para cómo se limpió el origen.
model Prospecto {
  id               Int                  @id @default(autoincrement())
  nombre           String?
  tipoInteres      TipoInteresProspecto
  fuente           String
  telefonos        String // separados por coma, ya normalizados a 10 dígitos
  email            String?
  nit              String?
  direccion        String?
  ciudad           String?
  departamento     String?
  sector           String?
  contactadoEn     DateTime?
  // Primera apertura del correo de invitación, vía webhook email.opened de
  // Resend (requiere tracking activado en el dominio -- ver routes/webhooks.js).
  abiertoEn        DateTime?
  // Primer clic real al botón del correo hacia la página (vía nuestro propio
  // redirect /api/prospectos/visita) -- no depende de configurar nada en
  // Resend, así que es la señal de interés real más confiable que tenemos.
  visitadoEn       DateTime?
  // Derecho de oposición a mercadeo directo (Ley 1581 de 2012, art. 8):
  // clic en el enlace de baja del correo, sin necesidad de cuenta.
  noContactar      Boolean              @default(false)
  // Autorización expresa de tratamiento de datos (Ley 1581): solo la tienen
  // los prospectos que dejaron sus datos ellos mismos (p. ej. formulario
  // /effix en ferias). Los de la base 2023 no la tienen -- por eso quedan null.
  consentimientoEn DateTime?
  // Contexto libre de la conversación: persona de contacto, cargo, qué
  // despachan y con qué frecuencia.
  notas            String?
  createdAt        DateTime             @default(now())

  @@index([tipoInteres])
}

// Registro de gastos del transportador. Un viaje puede venir de una carga
// desbloqueada en la plataforma (cargaId) o haberlo conseguido por fuera
// (cargaId null). Solo lo ve el propio transportador.
model Viaje {
  id              Int      @id @default(autoincrement())
  transportadorId Int
  cargaId         Int?
  origen          String
  destino         String
  descripcion     String?
  flete           Int // flete pactado real (puede diferir del publicado)
  fecha           DateTime
  createdAt       DateTime @default(now())

  transportador Transportador @relation(fields: [transportadorId], references: [id], onDelete: Cascade)
  carga         Carga?        @relation(fields: [cargaId], references: [id], onDelete: SetNull)
  gastos        Gasto[]

  @@unique([transportadorId, cargaId])
}

model Gasto {
  id        Int      @id @default(autoincrement())
  viajeId   Int
  tipo      String // ACPM, PEAJES, COMIDA, HOSPEDAJE, CARGUE, TALLER, OTROS (validado en routes/viajes.js)
  valor     Int
  fecha     DateTime
  nota      String?
  recibo    String? // nombre del archivo de la foto en UPLOADS_DIR/recibos
  createdAt DateTime @default(now())

  viaje Viaje @relation(fields: [viajeId], references: [id], onDelete: Cascade)
}
